<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>vef.keycloak</groupId>
        <artifactId>plf_clp_federation_id_keycloak_corporate</artifactId>
        <version>26.5.5.1</version>
    </parent>
    <artifactId>keycloak-image</artifactId>
    <name>VEF Keycloak Image</name>

    <packaging>pom</packaging>

    <build>
        <directory>${project.basedir}/providers</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-local-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-themes/target</directory>
                                    <includes>
                                        <include>keycloak-themes-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-franceconnect/target</directory>
                                    <includes>
                                        <include>keycloak-franceconnect-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-lastlogin-event-listener/target</directory>
                                    <includes>
                                        <include>keycloak-last-login-event-listener-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-scim-server/build/libs</directory>
                                    <includes>
                                        <include>keycloak-scim-server-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-2fa-email-authenticator/target</directory>
                                    <includes>
                                        <include>keycloak-2fa-email-authenticator-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-2fa-sms/target</directory>
                                    <includes>
                                        <include>keycloak-2fa-sms-authenticator-*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-metrics/target</directory>
                                    <includes>
                                        <include>keycloak-metrics-spi*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${project.parent.basedir}/keycloak-lastlogin-event-listener/build/libs</directory>
                                    <includes>
                                        <include>keycloak-last-login-event-listener*.jar</include>
                                    </includes>
                                    <excludes>
                                        <exclude>**/*-javadoc.jar</exclude>
                                        <exclude>**/*-sources.jar</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
