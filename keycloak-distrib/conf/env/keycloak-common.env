# Shared Keycloak defaults used by local distrib and docker-compose.
# Environment-specific values (DB host/password, admin password, etc.) can override these.

KC_HOSTNAME_STRICT=false
KC_CACHE_CONFIG_MUTATE=true
KC_CACHE_STACK=jdbc-ping
KC_LOG_FORMAT="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p [%c] (%t) %s%e%n"
KC_LOG_LEVEL=INFO
SCIM_AUTHENTICATION_MODE=KEYCLOAK
KC_METRICS_ENABLED=true
KC_HEALTH_ENABLED=true
JAVA_OPTS_APPEND="-Dnetworkaddress.cache.ttl=10 -Dnetworkaddress.cache.negative.ttl=0"

# SMS OCX gateway (set concrete values in shell/.env, do not commit secrets)
SMS_API_FORMAT=ocx
# SMS_API_URL=
# SMS_API_TOKEN_URL=
# SMS_API_CLIENT_ID=
# SMS_API_CLIENT_SECRET=
# SMS_API_SCOPE=
# SMS_API_SENDER=VEO
# SMS_API_BILLING_CODE=IDDG
