{
  "realm": "theme-collectivites",
  "enabled": true,
  "loginTheme": "collectivites",
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false
    }
  ],
  "users": [
    {
      "username": "themeuser",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "theme-collectivites-client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://example.com",
        "http://example.com/*"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ]
}
