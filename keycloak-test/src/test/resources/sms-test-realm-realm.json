{
  "realm": "sms-test-realm",
  "enabled": true,
  "browserFlow": "browser-sms",
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-sms",
      "description": "Browser authentication with SMS second factor",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-sms-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-sms-forms",
      "description": "Username/password form followed by SMS OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "sms-authenticator",
          "authenticatorConfig": "sms-otp-config",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "sms-otp-config",
      "config": {
        "length": "6",
        "ttl": "300",
        "senderId": "TestSender",
        "simulation": "true"
      }
    }
  ],
  "users": [
    {
      "username": "smsuser",
      "enabled": true,
      "email": "smsuser@test.com",
      "attributes": {
        "mobile_number": ["+33612345678"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "sms-test-client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://example.com", "http://example.com/*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ]
}
