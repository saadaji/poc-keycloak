{
  "realm": "email-test-realm",
  "enabled": true,
  "browserFlow": "browser-email",
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-email",
      "description": "Browser authentication with Email OTP second factor",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser-email-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-email-forms",
      "description": "Username/password form followed by Email OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "email-authenticator",
          "authenticatorConfig": "email-otp-config",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "email-otp-config",
      "config": {
        "length": "6",
        "ttl": "300",
        "simulationMode": "true",
        "resendCooldown": "30",
        "maxAttempts": "5",
        "emailProviderType": "KEYCLOAK"
      }
    }
  ],
  "users": [
    {
      "username": "emailuser",
      "enabled": true,
      "email": "emailuser@test.com",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "email-test-client",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://example.com", "http://example.com/*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    }
  ]
}
